{
  "name": "wombat-api-template",
  "build": {
    "dockerfile": "../cross/Dockerfile",
    "context": ".."
  },
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "remoteUser": "dev",
  "updateRemoteUserUID": true,
  "customizations": {
    "vscode": {
      "extensions": [
        "llvm-vs-code-extensions.vscode-clangd",
        "mesonbuild.mesonbuild"
      ],
      "settings": {
        "clangd.path": "/usr/bin/clangd",
        "clangd.arguments": [
          "--compile-commands-dir=/workspace",
          "--background-index",
          "--header-insertion=never"
        ]
      }
    }
  },
  "//": "SSH agent forwarding is automatic in dev containers; the mount below is a fallback for key-based auth to the Wombat.",
  "mounts": [
    "source=${localEnv:HOME}/.ssh,target=/home/dev/.ssh,type=bind,readonly"
  ],
  "postCreateCommand": "scripts/build.sh || true"
}
