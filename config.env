# User configuration for the Wombat API Debian Template.
# Sourced by the scripts in scripts/. This is the only file you normally edit.

# Build target architecture:
#   arm64  -> for the Wombat        [default]
#   amd64  -> for local testing on an x86_64 host
ARCH=arm64

# Name of the output binary.
PROGRAM_NAME=wombat-test

# SSH target for upload/run: <user>@<host> of your Wombat.
TARGET_HOST=user@wombat3321

# Remote directory the binary is copied to and run from.
TARGET_DIR=/home/user/urc-programs/wombat/${PROGRAM_NAME}/bin

# Prebuilt dev image (built + pushed by CI).
IMAGE=git.robo4you.at/unified-robot-control/wombat-api-template-debian:latest
